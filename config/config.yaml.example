llm:
  provider: caii   # caii | vllm | ollama
  caii:
    endpoint: https://<workspace-domain>/namespaces/serving-default/endpoints/<endpoint-name>/v1
    model: <model-id>
    api_key: ""   # leave blank; JWT read from /tmp/jwt automatically in CML
  vllm:
    endpoint: http://localhost:8000/v1
    model: meta-llama/Llama-3.1-8B-Instruct
    api_key: ""
  ollama:
    endpoint: http://localhost:11434/v1
    model: llama3.1:8b
    api_key: ollama
  temperature: 0.1
  max_tokens: 4096

data:
  db_path: data/npi.db      # ops store
  raw_dir: data/raw         # csv source fallback
  kb_dir: data/kb           # lance dataset + raw assets

source:
  backend: auto             # auto | iceberg | csv  (Phase 1: csv)
  csv_dir: data/raw

demo:
  showcase_program_id: PACK-ATLAS-01

ml:
  model_dir: models
  seed: 42

# Data mode is independent of NPI_APP_MODE (prod/dev frontend serving).
runtime:
  data_mode: demo            # demo | pilot; NPI_DATA_MODE overrides
pilot:
  provider: unconfigured     # canonical_import; NPI_SOURCE_PROVIDER overrides
  import_path: ""            # read-only npi-pilot-v1 JSON; NPI_PILOT_SOURCE overrides
  ops_db_path: data/pilot/npi.db  # isolated from demo results/models/reviews
# Workbench authorization defaults fail closed when platform markers are present.
# Configure NPI_AUTH_MODE=workbench, NPI_PUBLIC_ORIGIN=https://<private-app-host>,
# and NPI_TRUSTED_PROXY_CIDRS=<verified ingress socket peer CIDR> at deployment.
# Never expose the loopback backend or use public/unauthenticated Applications.

# Offline deterministic default. Existing configs without this block use these defaults.
knowledge:
  embedding:
    version: token-hash-v2
    model: sha256-token-bag
    dimension: 128
    tokenizer: unicode-word-lower-v1
    normalization: l2
    dtype: float32
  ocr:
    model: gpt-6-luna
    base_url: https://api.openai.com/v1
    timeout_seconds: 45
    max_output_tokens: 4096
    max_retries: 0
# OPENAI_API_KEY is read only from the environment during explicit paid OCR.
# prepare.py and runtime search never initiate paid OCR.
